---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getSettings } from '../lib/content';
import { url } from '../lib/url';
import '../styles/global.css';

interface Props {
  /** Page title; the site name is appended automatically. */
  title?: string;
  description?: string;
  /** Absolute or site-relative URL of the image shown when the page is shared. */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const settings = await getSettings();
const { title, description = settings.description, image, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} | ${settings.name}` : `${settings.name} | Journalistiek, van verhaal tot video`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image ?? url('og-default.png'), Astro.site).href;
// While the site is a preview, search engines are asked to stay away.
const noindex = Astro.props.noindex || settings.preview;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="alternate" type="application/rss+xml" title={settings.name} href={url('rss.xml')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? settings.name} />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="nl_NL" />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

    <Font cssVariable="--font-inter" preload />
  </head>
  <body>
    <a class="skip-link" href="#main">Naar de inhoud</a>
    {
      settings.preview && (
        <p class="preview-banner">
          <strong>Voorbeeldversie</strong> · Teksten en foto's zijn tijdelijk en worden nog vervangen.
        </p>
      )
    }
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer settings={settings} />
    {settings.analytics_id && <CookieConsent measurementId={settings.analytics_id} />}
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -4rem;
    padding: var(--space-2) var(--space-4);
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-radius: var(--radius-small);
    z-index: 30;
  }

  .skip-link:focus {
    top: var(--space-4);
  }

  .preview-banner {
    margin: 0;
    padding: var(--space-2) var(--gutter);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: var(--text-xs);
    text-align: center;
  }
</style>
