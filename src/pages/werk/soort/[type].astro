---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TypeFilter from '../../../components/TypeFilter.astro';
import WorkGrid from '../../../components/WorkGrid.astro';
import { getWork } from '../../../lib/content';
import { WORK_TYPES, WORK_TYPE_KEYS, type WorkType } from '../../../lib/work-types';

export async function getStaticPaths() {
  const work = await getWork();
  const available = WORK_TYPE_KEYS.filter((type) => work.some((entry) => entry.data.type === type));
  return available.map((type) => ({
    params: { type },
    props: { entries: work.filter((entry) => entry.data.type === type), available },
  }));
}

const type = Astro.params.type as WorkType;
const { entries, available } = Astro.props;
const { plural } = WORK_TYPES[type];
---

<BaseLayout title={`${plural} | Werk`}>
  <div class="container section">
    <h1>{plural}</h1>
    <TypeFilter available={available} current={type} />
    <WorkGrid entries={entries} eager={3} />
  </div>
</BaseLayout>

<style>
  h1 {
    font-size: var(--text-3xl);
    margin-bottom: 1.5rem;
  }
</style>
