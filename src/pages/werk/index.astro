---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TypeFilter from '../../components/TypeFilter.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import { getWork } from '../../lib/content';
import { WORK_TYPE_KEYS } from '../../lib/work-types';

const work = await getWork();
const available = WORK_TYPE_KEYS.filter((type) => work.some((entry) => entry.data.type === type));
---

<BaseLayout title="Werk" description="Artikelen, video's, audio en fotografie.">
  <div class="container section">
    <h1>Werk</h1>
    <TypeFilter available={available} />
    <WorkGrid entries={work} eager={3} />
  </div>
</BaseLayout>

<style>
  h1 {
    font-size: var(--text-3xl);
    margin-bottom: 1.5rem;
  }
</style>
