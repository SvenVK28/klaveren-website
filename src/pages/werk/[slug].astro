---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaEmbed from '../../components/MediaEmbed.astro';
import { coverOf, getWork, workUrl } from '../../lib/content';
import { parseEmbed } from '../../lib/embed';
import { formatDate, readingTime } from '../../lib/format';
import { url } from '../../lib/url';
import { WORK_TYPES } from '../../lib/work-types';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    // `work` is newest first, so the next item in the list is the older one.
    props: { entry, newer: work[i - 1], older: work[i + 1] },
  }));
}

const { entry, newer, older } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const typeLabel = WORK_TYPES[data.type].label;
const minutes = data.type === 'artikel' && entry.body ? readingTime(entry.body) : undefined;
// Video and audio pieces lead with the player; the cover photo is then only used for cards and sharing.
const showCover = data.cover && !(data.media_url && (data.type === 'video' || data.type === 'audio'));

const cover = coverOf(entry);
const shareImage =
  typeof cover === 'object'
    ? (await getImage({ src: cover, width: 1200, height: 630, format: 'jpg' })).src
    : parseEmbed(data.media_url)?.thumbnailFallback;
---

<BaseLayout title={data.title} description={data.summary} image={shareImage} type="article">
  <article>
    <header class="container narrow head">
      <a class="back" href={url('werk/')}>← Alle werk</a>
      <p class="eyebrow meta">
        <a class="type" href={url(`werk/soort/${data.type}/`)}>{typeLabel}</a>
        <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
        {minutes && <span>{minutes} min lezen</span>}
        {data.draft && <span class="draft">Concept: niet zichtbaar op de site</span>}
      </p>
      <h1>{data.title}</h1>
      {data.summary && <p class="lede">{data.summary}</p>}

      {
        (data.publication || data.context || data.credits) && (
          <dl class="facts">
            {data.publication && (
              <div>
                <dt>Gepubliceerd bij</dt>
                <dd>{data.publication}</dd>
              </div>
            )}
            {data.context && (
              <div>
                <dt>Context</dt>
                <dd>{data.context}</dd>
              </div>
            )}
            {data.credits && (
              <div>
                <dt>Met</dt>
                <dd>{data.credits}</dd>
              </div>
            )}
          </dl>
        )
      }
    </header>

    {
      showCover && data.cover && (
        <figure class="container cover">
          <Image
            src={data.cover}
            alt={data.cover_alt ?? ''}
            width={1600}
            sizes="(min-width: 72rem) 72rem, 100vw"
            loading="eager"
            fetchpriority="high"
          />
          {data.cover_credit && <figcaption>Foto: {data.cover_credit}</figcaption>}
        </figure>
      )
    }

    <div class="container narrow">
      {data.media_url && <MediaEmbed link={data.media_url} title={data.title} />}

      <div class="prose">
        <Content />
      </div>

      {
        data.gallery.length > 0 && (
          <section class="gallery" aria-label="Fotoserie">
            {data.gallery.map((item) => (
              <figure>
                <Image src={item.image} alt={item.caption ?? ''} width={1400} sizes="(min-width: 48rem) 42rem, 100vw" />
                {item.caption && <figcaption>{item.caption}</figcaption>}
              </figure>
            ))}
          </section>
        )
      }

      {
        (data.external_url || data.attachments.length > 0) && (
          <div class="links">
            {data.external_url && (
              <a class="button button--primary" href={data.external_url} target="_blank" rel="noopener">
                {data.publication ? `Bekijk bij ${data.publication}` : 'Bekijk de originele publicatie'} ↗
              </a>
            )}
            {data.attachments.map((attachment) => (
              <a class="button" href={url(attachment.file)} target="_blank" rel="noopener">
                {attachment.label ?? 'Download bijlage'} ↓
              </a>
            ))}
          </div>
        )
      }

      {
        data.tags.length > 0 && (
          <ul class="tags" aria-label="Onderwerpen">
            {data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </div>
  </article>

  {
    (newer || older) && (
      <nav class="container narrow pager" aria-label="Meer werk">
        {older && (
          <a class="older" href={workUrl(older)} rel="prev">
            <span class="eyebrow">← Ouder</span>
            <span class="pager-title">{older.data.title}</span>
          </a>
        )}
        {newer && (
          <a class="newer" href={workUrl(newer)} rel="next">
            <span class="eyebrow">Nieuwer →</span>
            <span class="pager-title">{newer.data.title}</span>
          </a>
        )}
      </nav>
    )
  }
</BaseLayout>

<style>
  .narrow {
    max-width: calc(var(--width-prose) + 2 * var(--gutter));
  }

  .head {
    padding-top: clamp(2rem, 1rem + 4vw, 4rem);
    padding-bottom: 2.5rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .meta a {
    text-decoration: none;
  }

  .draft {
    color: var(--color-accent-text);
    background: var(--color-accent);
    padding: 0 0.4em;
    border-radius: 0.2rem;
  }

  h1 {
    font-size: var(--text-3xl);
    margin-block: 0.75rem 1.25rem;
  }

  .lede {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: 1.45;
    color: var(--color-muted);
  }

  .facts {
    display: grid;
    gap: 0.75rem;
    margin: 2rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .facts div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
  }

  .facts dt {
    color: var(--color-muted);
  }

  .facts dd {
    margin: 0;
    font-weight: 600;
  }

  .cover {
    margin-block: 0 2.5rem;
  }

  .cover :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .gallery {
    display: grid;
    gap: 2.5rem;
    margin-block: 3rem;
  }

  .gallery figure {
    margin: 0;
  }

  .gallery :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block: 2.5rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.2em 0.75em;
    border-radius: 999px;
    background: var(--color-placeholder);
    font-size: var(--text-sm);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: var(--space-section);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    text-decoration: none;
  }

  .pager .newer {
    grid-column: 2;
    text-align: right;
  }

  .pager-title {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.25;
  }

  @media (max-width: 40rem) {
    .facts div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
