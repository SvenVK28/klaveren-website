---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Pagina niet gevonden">
  <div class="container section">
    <p class="eyebrow">404</p>
    <h1>Deze pagina bestaat niet (meer).</h1>
    <p>Misschien is de link veranderd. Bekijk al het werk of ga terug naar de homepage.</p>
    <p class="actions">
      <a class="button button--primary" href={url('werk/')}>Alle werk</a>
      <a class="button" href={url()}>Homepage</a>
    </p>
  </div>
</BaseLayout>

<style>
  h1 {
    font-size: var(--text-3xl);
    max-width: 20ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
