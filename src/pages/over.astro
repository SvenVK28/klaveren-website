---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAbout, getSettings } from '../lib/content';
import { url } from '../lib/url';

const settings = await getSettings();
const about = await getAbout();
const { Content } = await render(about);
const { data } = about;
const shareImage = data.photo ? (await getImage({ src: data.photo, width: 1200, format: 'jpg' })).src : undefined;
---

<BaseLayout title={data.title} description={data.intro} image={shareImage}>
  <div class="container section layout">
    {
      data.photo && (
        <figure class="photo">
          <Image src={data.photo} alt={data.photo_alt ?? settings.name} width={800} height={1000} loading="eager" />
        </figure>
      )
    }
    <div class="text">
      <h1>{data.title}</h1>
      {data.intro && <p class="lede">{data.intro}</p>}
      <div class="prose">
        <Content />
      </div>

      <section class="contact" aria-labelledby="contact-title">
        <h2 id="contact-title">Contact</h2>
        <p class="actions">
          {
            settings.email && (
              <a class="button button--primary" href={`mailto:${settings.email}`}>
                Mail mij
              </a>
            )
          }
          {
            settings.cv && (
              <a class="button" href={url(settings.cv)} target="_blank" rel="noopener">
                Download cv ↓
              </a>
            )
          }
        </p>
        {
          settings.socials.length > 0 && (
            <ul class="socials">
              {settings.socials.map((social) => (
                <li>
                  <a href={social.url} rel="me noopener" target="_blank">
                    {social.platform} ↗
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .photo {
    margin: 0;
    position: sticky;
    top: 2rem;
  }

  .photo :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .lede {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: 1.45;
    max-width: var(--width-prose);
  }

  .contact {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .contact h2 {
    font-size: var(--text-xl);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
  }

  @media (max-width: 48rem) {
    .layout {
      grid-template-columns: 1fr;
    }

    .photo {
      position: static;
      max-width: 18rem;
    }
  }
</style>
