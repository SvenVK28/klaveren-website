---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaEmbed from '../../components/MediaEmbed.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { categoryOf, coverOf, getCategories, getSettings, getWork, workUrl, type Work } from '../../lib/content';
import { parseEmbed } from '../../lib/embed';
import { formatDate } from '../../lib/format';
import { url } from '../../lib/url';
import { PROJECT_TYPES } from '../../lib/work-types';
import type { IconName } from '../../lib/icons';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((entry) => {
    // "Meer werk": same category first, then the rest, in site order.
    const others = work.filter((other) => other.id !== entry.id);
    const more = [...others.filter((o) => o.data.type === entry.data.type), ...others.filter((o) => o.data.type !== entry.data.type)].slice(0, 3);
    return { params: { slug: entry.id }, props: { entry, more } };
  });
}

interface Props {
  entry: Work;
  more: Work[];
}

const { entry, more } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const settings = await getSettings();

const categories = await getCategories();
const type = categoryOf(categories, data.type);
const embed = parseEmbed(data.media_url);
// Video and audio lead with the player (the cover becomes its still); otherwise the cover photo.
const showCover = data.cover && !embed;
const cover = coverOf(entry);
const shareImage =
  typeof cover === 'object' ? (await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src : embed?.thumbnailFallback;
const pageUrl = new URL(workUrl(entry), Astro.site).href;
const share = [
  { label: 'LinkedIn', icon: 'linkedin', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}` },
  { label: 'WhatsApp', icon: 'chat', href: `https://wa.me/?text=${encodeURIComponent(`${data.title} ${pageUrl}`)}` },
  { label: 'E-mail', icon: 'mail', href: `mailto:?subject=${encodeURIComponent(data.title)}&body=${encodeURIComponent(pageUrl)}` },
] as const;

const facts = [
  data.role && { icon: 'user', label: 'Mijn rol', value: data.role },
  data.show_date && { icon: 'calendar', label: 'Datum', value: formatDate(data.date) },
  { icon: 'tag', label: 'Categorie', value: type.label },
  data.project_type && { icon: 'folder', label: 'Soort project', value: PROJECT_TYPES[data.project_type] },
  data.publication && { icon: 'newspaper', label: 'Gepubliceerd bij', value: data.publication },
  data.context && { icon: 'document', label: 'Context', value: data.context },
  data.credits && { icon: 'videocamera', label: 'Gemaakt met', value: data.credits },
].filter(Boolean) as { icon: IconName; label: string; value: string }[];
---

<BaseLayout title={data.title} description={data.summary} image={shareImage} type="article">
  <div class="container layout">
    <article class="main">
      <a class="text-link back" href={url('mijn-werk/')}>
        <Icon name="arrow-left" />
        Mijn werk
      </a>

      {data.media_url && <MediaEmbed link={data.media_url} title={data.title} poster={data.cover} />}
      {
        showCover && data.cover && (
          <figure class="cover">
            <Image
              src={data.cover}
              alt={data.cover_alt ?? ''}
              width={1200}
              sizes="(min-width: 75rem) 46rem, (min-width: 56rem) 62vw, 100vw"
              loading="eager"
              fetchpriority="high"
            />
            {data.cover_credit && <figcaption>Foto: {data.cover_credit}</figcaption>}
          </figure>
        )
      }

      <header class="head">
        <p class="eyebrow category">
          {type.label}
          {data.draft && <span class="draft"> · Concept: niet zichtbaar op de site</span>}
        </p>
        <h1>{data.title}</h1>
        {data.summary && <p class="lede">{data.summary}</p>}
      </header>

      <div class="prose">
        <Content />
      </div>

      {
        data.gallery.length > 0 && (
          <section class="gallery" aria-label="Foto's">
            {data.gallery.map((item) => (
              <figure>
                <Image src={item.image} alt={item.caption ?? ''} width={1400} sizes="(min-width: 56rem) 46rem, 100vw" />
                {item.caption && <figcaption>{item.caption}</figcaption>}
              </figure>
            ))}
          </section>
        )
      }

      {
        (data.external_url || data.attachments.length > 0) && (
          <div class="actions links">
            {data.external_url && (
              <a class="button button--primary" href={data.external_url} target="_blank" rel="noopener">
                {data.publication ? `Bekijk bij ${data.publication}` : 'Bekijk de originele publicatie'}
                <Icon name="external" />
              </a>
            )}
            {data.attachments.map((attachment) => (
              <a class="button" href={url(attachment.file)} target="_blank" rel="noopener">
                {attachment.label ?? 'Download bijlage'}
                <Icon name="download" />
              </a>
            ))}
          </div>
        )
      }
    </article>

    <aside class="aside" aria-label="Over dit project">
      <p class="eyebrow category">{type.label}</p>
      <dl class="facts">
        {
          facts.map((fact) => (
            <div>
              <Icon name={fact.icon} />
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>

      {
        more.length > 0 && (
          <section class="more" aria-labelledby="more-title">
            <h2 id="more-title">Meer werk</h2>
            <ul>
              {more.map((other) => {
                const thumb = coverOf(other);
                return (
                  <li>
                    <span class="thumb">
                      {typeof thumb === 'object' ? (
                        <Image src={thumb} alt="" width={160} height={120} fit="cover" />
                      ) : thumb ? (
                        <img src={thumb} alt="" width="160" height="120" loading="lazy" />
                      ) : null}
                    </span>
                    <span class="more-text">
                      <span class="eyebrow category">{categoryOf(categories, other.data.type).label}</span>
                      <a href={workUrl(other)}>{other.data.title}</a>
                      <Icon name="arrow" />
                    </span>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }

      <section class="share" aria-labelledby="share-title">
        <h2 id="share-title">Deel dit project</h2>
        <ul>
          {
            share.map((item) => (
              <li>
                <a href={item.href} target="_blank" rel="noopener">
                  <Icon name={item.icon} />
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="copy" hidden>
            <button type="button" data-url={pageUrl}>
              <Icon name="link" />
              <span>Kopieer link</span>
            </button>
          </li>
        </ul>
      </section>
    </aside>
  </div>

  <CtaBand
    eyebrow={settings.project_cta.eyebrow ?? 'Vragen of een freelanceopdracht?'}
    title={settings.project_cta.title ?? 'Een idee of opdracht?'}
    text={settings.project_cta.text}
    button={settings.project_cta.button ?? 'Neem contact op'}
    href={url('contact/')}
  />
</BaseLayout>

<script>
  const item = document.querySelector<HTMLElement>('.share .copy');
  const button = item?.querySelector<HTMLButtonElement>('button');
  if (item && button && navigator.clipboard) {
    item.hidden = false;
    const label = button.querySelector('span')!;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.url!);
        label.textContent = 'Link gekopieerd';
      } catch {
        label.textContent = 'Kopiëren lukte niet';
      }
      setTimeout(() => (label.textContent = 'Kopieer link'), 2500);
    });
  }
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 19rem;
    gap: var(--space-12) clamp(var(--space-8), 5vw, var(--space-16));
    padding-block: var(--space-8) var(--space-section);
  }

  .main {
    min-width: 0;
    max-width: 46rem;
  }

  .back {
    margin-bottom: var(--space-4);
  }

  .back :global(.icon) {
    width: 1em;
    height: 1em;
  }

  .cover {
    margin: 0 0 var(--space-8);
  }

  .cover :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-small);
  }

  figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .category {
    color: var(--color-accent);
  }

  .draft {
    color: #b42318;
  }

  h1 {
    font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3rem);
    line-height: 1.1;
    margin-bottom: var(--space-6);
  }

  .lede {
    color: var(--color-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.5;
    margin-bottom: var(--space-8);
  }

  .gallery {
    display: grid;
    gap: var(--space-8);
    margin-block: var(--space-12);
  }

  .gallery figure {
    margin: 0;
  }

  .gallery :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-small);
  }

  .links {
    margin-block: var(--space-8) 0;
  }

  /* Sidebar */
  .aside {
    padding-left: clamp(var(--space-8), 3vw, var(--space-12));
    border-left: 1px solid var(--color-border);
    padding-top: calc(44px + var(--space-4));
  }

  .aside h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  .facts {
    display: grid;
    gap: var(--space-4);
    margin: 0 0 var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .facts div {
    display: grid;
    grid-template-columns: 28px 1fr;
    column-gap: var(--space-3);
  }

  .facts :global(.icon) {
    grid-row: span 2;
    width: 24px;
    height: 24px;
    color: var(--color-primary);
  }

  .facts dt {
    color: var(--color-heading);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .facts dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .more {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .more ul,
  .share ul {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .more li {
    position: relative;
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  .thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-small);
    background: var(--color-placeholder);
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .more-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .more-text .eyebrow {
    margin: 0;
    font-size: 0.6875rem;
  }

  .more-text a {
    color: var(--color-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none;
  }

  .more-text a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .more li:hover a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .more-text :global(.icon) {
    width: 16px;
    height: 16px;
    color: var(--color-primary);
  }

  .share a,
  .share button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 40px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-heading);
    font: inherit;
    font-size: var(--text-sm);
    text-decoration: none;
    cursor: pointer;
  }

  .share a:hover,
  .share button:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .share :global(.icon) {
    width: 22px;
    height: 22px;
    color: var(--color-primary);
  }

  .share ul {
    gap: var(--space-1);
  }

  @media (max-width: 56rem) {
    .layout {
      grid-template-columns: 1fr;
    }

    .aside {
      padding: var(--space-8) 0 0;
      border-left: 0;
      border-top: 1px solid var(--color-border);
    }
  }
</style>
