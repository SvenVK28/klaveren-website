---
import WorkIndex from '../../../components/WorkIndex.astro';
import { getCategories, getWork } from '../../../lib/content';

export async function getStaticPaths() {
  const work = await getWork();
  // Only categories with at least one project get a page.
  const categories = await getCategories();
  return categories.filter((category) => work.some((entry) => entry.data.type === category.key)).map((category) => ({
    params: { type: category.key },
  }));
}

const { type } = Astro.params;
---

<WorkIndex type={type} />
