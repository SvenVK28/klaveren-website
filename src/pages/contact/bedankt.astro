---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContact } from '../../lib/content';
import { url } from '../../lib/url';

// Where the contact form sends visitors whose browser runs no JavaScript.
const { data } = await getContact();
---

<BaseLayout title="Bericht verstuurd" noindex>
  <div class="container section">
    <p class="eyebrow">Contact</p>
    <h1>Bericht verstuurd</h1>
    <p class="intro">{data.success_message}</p>
    <p class="actions">
      <a class="button button--primary" href={url('mijn-werk/')}>Bekijk mijn werk</a>
      <a class="button" href={url()}>Naar de homepage</a>
    </p>
  </div>
</BaseLayout>

<style>
  h1 {
    font-size: var(--text-page);
  }

  .intro {
    max-width: 36rem;
    font-size: var(--text-md);
    margin-bottom: var(--space-8);
  }
</style>
