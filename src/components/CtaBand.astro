---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  button: string;
  href: string;
  /** Optional photo on the right, behind a navy fade. */
  image?: ImageMetadata;
}

const { eyebrow, title, text, button, href, image } = Astro.props;
---

<section class:list={['cta', { 'cta--image': image }]} aria-label={title}>
  {
    image && (
      <div class="media" aria-hidden="true">
        <Image src={image} alt="" layout="full-width" widths={[640, 1024, 1600]} sizes="(min-width: 48rem) 60vw, 100vw" />
      </div>
    )
  }
  <div class="container inner">
    <span class="mark" aria-hidden="true"><Icon name="mail" /></span>
    <div class="text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <p class="title">{title}</p>
      {text && <p class="body">{text}</p>}
    </div>
    <a class="button button--light" href={href}>
      {button}
      <Icon name="arrow" />
    </a>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-6) var(--space-8);
    padding-block: var(--space-12);
  }

  .mark {
    flex: none;
    padding-right: var(--space-8);
    border-right: 1px solid rgb(255 255 255 / 0.25);
  }

  .mark :global(.icon) {
    width: 36px;
    height: 36px;
    stroke-width: 1.4;
  }

  .text {
    flex: 1;
    max-width: 40rem;
  }

  .eyebrow {
    color: rgb(255 255 255 / 0.8);
    margin-bottom: var(--space-2);
  }

  .title {
    margin: 0;
    font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.25;
    text-wrap: balance;
  }

  .body {
    margin: var(--space-2) 0 0;
    color: rgb(255 255 255 / 0.85);
  }

  .button {
    flex: none;
    margin-left: auto;
  }

  .media {
    position: absolute;
    inset: 0 0 0 auto;
    width: 60%;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--color-primary) 0%, rgb(18 51 74 / 0.75) 40%, rgb(18 51 74 / 0.45) 100%);
  }

  .cta--image .inner {
    padding-block: var(--space-16);
  }

  @media (max-width: 47.99rem) {
    .inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .button {
      margin-left: 0;
    }

    .mark {
      display: none;
    }

    .media {
      width: 100%;
    }

    .media::after {
      background: rgb(18 51 74 / 0.82);
    }
  }
</style>
