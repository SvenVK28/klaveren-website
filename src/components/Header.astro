---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV_LINKS } from '../lib/nav';
import { isActive, url } from '../lib/url';

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container inner">
    <a class="home" href={url()} aria-label="SCVK Media, naar de homepage">
      <Logo height={40} eager alt="" />
    </a>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
      <Icon name="menu" class="open" />
      <Icon name="close" class="close" />
      <span class="menu-label">Menu</span>
    </button>

    <nav id="site-nav" aria-label="Hoofdmenu">
      <ul>
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={url(link.href)} aria-current={isActive(current, link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Phone menu. Without JavaScript the links simply stay visible under the logo.
  const header = document.querySelector<HTMLElement>('.site-header');
  const button = header?.querySelector<HTMLButtonElement>('.menu-button');
  if (header && button) {
    button.hidden = false;
    header.classList.add('has-menu');
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      header.classList.toggle('is-open', open);
    };
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('is-open')) {
        setOpen(false);
        button.focus();
      }
    });
    matchMedia('(min-width: 48rem)').addEventListener('change', () => setOpen(false));
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-6);
    min-height: 72px;
  }

  .home {
    display: block;
    padding-block: var(--space-3);
  }

  .home :global(.logo) {
    height: 40px;
    width: auto;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(var(--space-6), 3vw, 44px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-heading);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 2px;
    background: var(--color-primary);
    transform: scaleX(0);
    transition: transform 0.2s ease;
  }

  nav a:hover::after,
  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  nav a[aria-current='page'] {
    font-weight: 600;
  }

  .menu-button {
    display: none;
  }

  /* Phones: a menu button with a panel that drops below the header. */
  @media (max-width: 47.99rem) {
    .home :global(.logo) {
      height: 34px;
    }

    .has-menu .menu-button {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      min-height: 44px;
      padding: 0 var(--space-3);
      margin-right: calc(-1 * var(--space-3));
      border: 0;
      background: none;
      color: var(--color-heading);
      font: inherit;
      font-size: var(--text-sm);
      font-weight: 600;
      cursor: pointer;
    }

    .menu-button :global(.icon) {
      width: 24px;
      height: 24px;
    }

    .menu-button :global(.close),
    .is-open .menu-button :global(.open) {
      display: none;
    }

    .is-open .menu-button :global(.close) {
      display: block;
    }

    .has-menu nav {
      display: none;
      flex-basis: 100%;
      padding-bottom: var(--space-4);
    }

    .is-open nav {
      display: block;
    }

    .has-menu ul {
      flex-direction: column;
    }

    .has-menu nav li + li {
      border-top: 1px solid var(--color-border);
    }

    .has-menu nav a {
      display: flex;
      min-height: 52px;
      font-size: var(--text-md);
    }

    .has-menu nav a::after {
      display: none;
    }

    .has-menu nav a[aria-current='page'] {
      color: var(--color-primary);
      box-shadow: inset 3px 0 0 var(--color-primary);
      padding-left: var(--space-3);
    }

    /* No JavaScript: keep the links visible in a compact row. */
    .site-header:not(.has-menu) nav {
      flex-basis: 100%;
      padding-bottom: var(--space-2);
    }
  }
</style>
