---
import type { InferEntrySchema } from 'astro:content';
import { url } from '../lib/url';

interface Props {
  settings: InferEntrySchema<'settings'>;
}

const { settings } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div>
      <p class="name">{settings.name}</p>
      {settings.tagline && <p class="muted">{settings.tagline}</p>}
    </div>
    <ul class="links">
      {
        settings.email && (
          <li>
            <a href={`mailto:${settings.email}`}>{settings.email}</a>
          </li>
        )
      }
      {
        settings.socials.map((social) => (
          <li>
            <a href={social.url} rel="me noopener" target="_blank">
              {social.platform}
            </a>
          </li>
        ))
      }
      <li>
        <a href={url('rss.xml')}>RSS</a>
      </li>
    </ul>
    <p class="muted copyright">© {year} {settings.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-section);
    border-top: 1px solid var(--color-border);
    padding-block: 2.5rem;
    font-size: var(--text-sm);
  }

  .inner {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr auto;
    align-items: start;
  }

  .name {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
    margin: 0;
  }

  .muted {
    color: var(--color-muted);
    margin: 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .copyright {
    grid-column: 1 / -1;
  }

  @media (max-width: 40rem) {
    .inner {
      grid-template-columns: 1fr;
    }

    .links {
      justify-content: flex-start;
    }
  }
</style>
