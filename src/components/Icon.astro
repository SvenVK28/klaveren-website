---
import { iconSvg, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string;
  /** Accessible name. Without it the icon is decorative and hidden from screen readers. */
  label?: string;
}

const { name, class: className, label } = Astro.props;
---

<svg
  class:list={['icon', `icon--${name}`, className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={iconSvg(name)}
/>
