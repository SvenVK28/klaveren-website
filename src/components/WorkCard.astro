---
import { Image } from 'astro:assets';
import { coverOf, workUrl, type Work } from '../lib/content';
import { parseEmbed } from '../lib/embed';
import { formatDate } from '../lib/format';
import { WORK_TYPES } from '../lib/work-types';

interface Props {
  entry: Work;
  /** Set on the first cards of a page so their images load right away. */
  eager?: boolean;
  /** Heading level of the title, so the page outline stays logical. */
  level?: 2 | 3;
}

const { entry, eager = false, level = 3 } = Astro.props;
const { data } = entry;
const cover = coverOf(entry);
// Not every YouTube video has the wide thumbnail; fall back to the standard one.
const fallback = typeof cover === 'string' ? parseEmbed(data.media_url)?.thumbnailFallback : undefined;
const type = WORK_TYPES[data.type];
const Heading = level === 2 ? 'h2' : 'h3';
---

<article class="card">
  <div class="media">
    {
      typeof cover === 'object' ? (
        <Image
          src={cover}
          alt={data.cover_alt ?? ''}
          width={720}
          height={480}
          fit="cover"
          sizes="(min-width: 75rem) 23rem, (min-width: 40rem) 45vw, 100vw"
          loading={eager ? 'eager' : 'lazy'}
        />
      ) : cover ? (
        <img
          src={cover}
          alt={data.cover_alt ?? ''}
          width="720"
          height="480"
          loading={eager ? 'eager' : 'lazy'}
          onerror={fallback ? `this.onerror=null;this.src='${fallback}'` : undefined}
        />
      ) : (
        <span class="placeholder" aria-hidden="true" />
      )
    }
    <span class="badge">{type.label}</span>
  </div>
  <div class="body">
    <Heading class="title">
      <a href={workUrl(entry)}>{data.title}</a>
    </Heading>
    {data.summary && <p class="summary">{data.summary}</p>}
    {
      (data.show_date || data.publication || data.draft) && (
        <p class="meta">
          {data.draft && <span class="draft">Concept</span>}
          {data.publication && <span>{data.publication}</span>}
          {data.show_date && <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>}
        </p>
      )
    }
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
  }

  .media {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius-small);
    background: var(--color-placeholder);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card:hover .media :global(img) {
    transform: scale(1.03);
  }

  .placeholder {
    display: block;
    height: 100%;
    background:
      linear-gradient(135deg, transparent 49.6%, var(--color-border) 49.6% 50.4%, transparent 50.4%),
      var(--color-placeholder);
  }

  .badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    padding: 3px 8px;
    border-radius: 3px;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.5;
  }

  .title {
    font-size: var(--text-card);
    margin: 0 0 var(--space-2);
    line-height: 1.3;
  }

  .title a {
    color: var(--color-heading);
    text-decoration: none;
  }

  .card:hover .title a {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  /* Make the whole card clickable through the title link. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .title a:focus-visible {
    outline: none;
  }

  .title a:focus-visible::after {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: var(--radius-small);
  }

  .summary {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: var(--space-3) 0 0;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .meta span + time::before,
  .meta span + span::before {
    content: '·';
    margin-right: var(--space-3);
  }

  .draft {
    color: var(--color-accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
</style>
