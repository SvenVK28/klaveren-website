---
import { Image } from 'astro:assets';
import { coverOf, workUrl, type Work } from '../lib/content';
import { parseEmbed } from '../lib/embed';
import { formatDate } from '../lib/format';
import { WORK_TYPES } from '../lib/work-types';

interface Props {
  entry: Work;
  /** Larger card with a bigger title, used for featured work. */
  large?: boolean;
  /** Set on the first cards of a page so their images load right away. */
  eager?: boolean;
}

const { entry, large = false, eager = false } = Astro.props;
const { data } = entry;
const cover = coverOf(entry);
// Not every YouTube video has the wide thumbnail; fall back to the standard one.
const fallback = typeof cover === 'string' ? parseEmbed(data.media_url)?.thumbnailFallback : undefined;
const typeLabel = WORK_TYPES[data.type].label;
const sizes = large ? '(min-width: 72rem) 36rem, (min-width: 48rem) 50vw, 100vw' : '(min-width: 72rem) 24rem, (min-width: 40rem) 50vw, 100vw';
---

<article class:list={['card', { large }]}>
  <a class="media" href={workUrl(entry)} tabindex="-1" aria-hidden="true">
    {
      typeof cover === 'object' ? (
        <Image
          src={cover}
          alt=""
          width={large ? 1200 : 800}
          height={large ? 800 : 533}
          sizes={sizes}
          loading={eager ? 'eager' : 'lazy'}
        />
      ) : cover ? (
        <img
          src={cover}
          alt=""
          loading={eager ? 'eager' : 'lazy'}
          onerror={fallback ? `this.onerror=null;this.src='${fallback}'` : undefined}
        />
      ) : (
        <span class="placeholder">{typeLabel}</span>
      )
    }
    {(data.type === 'video' || data.type === 'audio') && data.media_url && <span class="play" aria-hidden="true" />}
  </a>
  <div class="body">
    <p class="eyebrow meta">
      <span class="type">{typeLabel}</span>
      <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
      {data.draft && <span class="draft">Concept</span>}
    </p>
    <h3 class="title">
      <a href={workUrl(entry)}>{data.title}</a>
    </h3>
    {data.summary && <p class="summary">{data.summary}</p>}
    {data.publication && <p class="publication">{data.publication}</p>}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .media {
    position: relative;
    display: block;
    text-decoration: none;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-placeholder);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card:hover .media :global(img) {
    transform: scale(1.03);
  }

  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--color-muted);
  }

  .play {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .play::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 0.5rem 0 0.5rem 0.8rem;
    border-color: transparent transparent transparent var(--color-accent-text);
    transform: translateX(0.1rem);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin: 0 0 0.4rem;
  }

  .draft {
    color: var(--color-accent-text);
    background: var(--color-accent);
    padding: 0 0.4em;
    border-radius: 0.2rem;
  }

  .title {
    font-size: var(--text-xl);
    margin: 0 0 0.4rem;
  }

  .large .title {
    font-size: var(--text-2xl);
  }

  .title a {
    text-decoration: none;
  }

  /* Make the whole card clickable through the title link. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .summary {
    color: var(--color-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .publication {
    margin: 0.5rem 0 0;
    font-size: var(--text-sm);
    font-weight: 600;
  }
</style>
