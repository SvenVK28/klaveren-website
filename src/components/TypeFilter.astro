---
import { url } from '../lib/url';
import { WORK_TYPES, type WorkType } from '../lib/work-types';

interface Props {
  /** Types that have at least one entry; others are hidden. */
  available: WorkType[];
  current?: WorkType;
}

const { available, current } = Astro.props;
---

{
  available.length > 1 && (
    <nav class="filter" aria-label="Filter op soort">
      <a href={url('werk/')} aria-current={!current ? 'page' : undefined}>
        Alles
      </a>
      {available.map((type) => (
        <a href={url(`werk/soort/${type}/`)} aria-current={type === current ? 'page' : undefined}>
          {WORK_TYPES[type].plural}
        </a>
      ))}
    </nav>
  )
}

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 3rem;
  }

  a {
    padding: 0.4em 1em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  a:hover {
    border-color: var(--color-text);
    color: inherit;
  }

  a[aria-current='page'] {
    background: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-bg);
  }
</style>
