---
import { url } from '../lib/url';
import { WORK_TYPES, type WorkType } from '../lib/work-types';

interface Props {
  /** Categories that have at least one entry; others are hidden. */
  available: WorkType[];
  current?: WorkType;
}

const { available, current } = Astro.props;
---

{
  available.length > 1 && (
    <nav class="filter" aria-label="Filter op categorie">
      <ul>
        <li>
          <a href={url('mijn-werk/')} aria-current={!current ? 'page' : undefined}>
            Alles
          </a>
        </li>
        {available.map((type) => (
          <li>
            <a href={url(`mijn-werk/soort/${type}/`)} aria-current={type === current ? 'page' : undefined}>
              {WORK_TYPES[type].plural}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .filter {
    margin-bottom: var(--space-12);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    color: var(--color-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  a:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  a[aria-current='page'] {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary);
  }
</style>
