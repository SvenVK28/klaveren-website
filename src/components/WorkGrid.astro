---
import WorkCard from './WorkCard.astro';
import type { Work } from '../lib/content';

interface Props {
  entries: Work[];
  /** How many of the first cards load their image eagerly. */
  eager?: number;
  level?: 2 | 3;
}

const { entries, eager = 0, level = 3 } = Astro.props;
---

{
  entries.length > 0 ? (
    <ul class="grid">
      {entries.map((entry, i) => (
        <li>
          <WorkCard entry={entry} eager={i < eager} level={level} />
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty">Hier verschijnt binnenkort mijn werk.</p>
  )
}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-12) var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 62rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-12) var(--space-6);
    }
  }

  @media (max-width: 36rem) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }
  }

  .empty {
    color: var(--color-muted);
  }
</style>
